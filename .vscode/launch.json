{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "unreviewedFilename",
      "type": "promptString",
      "description": "Base filename for unreviewed transaction exports",
      "default": "unreviewed_transactions"
    },
    {
      "id": "tagReportLookbackYears",
      "type": "promptString",
      "description": "Calendar years to include in tag activity report",
      "default": "3"
    },
    {
      "id": "yearlyPivotYears",
      "type": "promptString",
      "description": "Year columns: auto or comma-separated years",
      "default": "auto"
    },
    {
      "id": "yearlyPivotExcludeGroups",
      "type": "promptString",
      "description": "Groups to exclude from yearly pivots, comma-separated",
      "default": ""
    },
    {
      "id": "yearlyPivotExcludeCategories",
      "type": "promptString",
      "description": "Categories to exclude from yearly pivots, comma-separated",
      "default": ""
    },
    {
      "id": "recurringOptimizationLookbackMonths",
      "type": "promptString",
      "description": "Months to inspect, capped at 36",
      "default": "36"
    },
    {
      "id": "recurringOptimizationRecentMonths",
      "type": "promptString",
      "description": "Recent months for recency-weighted scoring",
      "default": "6"
    },
    {
      "id": "recurringOptimizationOptimizableType",
      "type": "pickString",
      "description": "Analyze selected category groups or wildcard category terms?",
      "options": [
        "groups",
        "categories"
      ],
      "default": "groups"
    },
    {
      "id": "copyTransactionIds",
      "type": "promptString",
      "description": "Transaction IDs to copy into push.csv (space, comma, semicolon, or newline separated)",
      "default": ""
    },
    {
      "id": "filterKind",
      "type": "pickString",
      "description": "Filter transactions by accounts, merchants, categories, groups, all files, or merchant/account files?",
      "options": [
        "merchants",
        "accounts",
        "categories",
        "groups",
        "all",
        "both"
      ],
      "default": "merchants"
    },
    {
      "id": "filterOutput",
      "type": "promptString",
      "description": "Output CSV path for filtered rows. Bare filenames like push3 become <data dir>/push3.csv",
      "default": "push.csv"
    },
    {
      "id": "filterWriteMode",
      "type": "pickString",
      "description": "Append to the output file or overwrite it?",
      "options": [
        "overwrite",
        "append"
      ],
      "default": "overwrite"
    },
    {
      "id": "pushInputFile",
      "type": "promptString",
      "description": "Push input CSV or JSON file (bare filename = inside the configured data dir)",
      "default": "push.csv"
    },
    {
      "id": "businessReportGroups",
      "type": "promptString",
      "description": "Comma-separated group search terms to include",
      "default": "Immanent"
    },
    {
      "id": "businessReportExcludeGroups",
      "type": "promptString",
      "description": "Optional comma-separated group search terms to exclude",
      "default": ""
    },
    {
      "id": "businessReportYear",
      "type": "promptString",
      "description": "Fiscal year for the business report",
      "default": "2026"
    }
  ],
  "configurations": [
    {
      "name": "Auth - Login",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/auth/login.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pull - Categories and Tags",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pull/pull_cats_tags.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pull - Category Groups",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pull/pull_category_groups.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pull - Account Groups",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pull/pull_account_groups.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pull - Transactions and Unreviewed",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pull/pull_transactions_persist_batches.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pull - Unreviewed Only",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pull/get_unreviewed.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filename",
        "${input:unreviewedFilename}"
      ]
    },
    {
      "name": "Review - Unreviewed Pivot Report",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/report_unreviewed_pivots.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Review - Filter Unreviewed Merchants To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "merchants",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter Unreviewed Accounts To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "accounts",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter Unreviewed Categories To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "categories",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter Unreviewed Groups To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "groups",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter Unreviewed Merchant/Account To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "both",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter Unreviewed All To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_unreviewed_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "all",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Filter All To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/filter_all_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--filter-type",
        "${input:filterKind}",
        "--output",
        "${input:filterOutput}",
        "--write-mode",
        "${input:filterWriteMode}"
      ]
    },
    {
      "name": "Review - Copy Transaction IDs To Push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/copy_transaction_ids_to_push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--transaction-ids",
        "${input:copyTransactionIds}"
      ]
    },
    {
      "name": "Push - Dry Run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--input-file",
        "${input:pushInputFile}",
        "--dry-run",
        "true"
      ]
    },
    {
      "name": "Push - Live + Update Local",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--input-file",
        "${input:pushInputFile}",
        "--dry-run",
        "false",
        "--update-local",
        "true"
      ]
    },
    {
      "name": "Push - Post-Failure Local Update",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/push/push.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--input-file",
        "${input:pushInputFile}",
        "--local-only",
        "true"
      ]
    },
    {
      "name": "Reports - Group Net By Year CSV (Legacy)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/report_group_net_by_year.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Reports - Yearly Amount Pivots",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/report_yearly_amount_pivots.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--years",
        "${input:yearlyPivotYears}",
        "--exclude-groups",
        "${input:yearlyPivotExcludeGroups}",
        "--exclude-categories",
        "${input:yearlyPivotExcludeCategories}"
      ]
    },
    {
      "name": "Reports - Tag Activity",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/report_tag_activity.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--lookback-years",
        "${input:tagReportLookbackYears}"
      ]
    },
    {
      "name": "Reports - Recurring Optimization",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/report_recurring_optimization.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--lookback-months",
        "${input:recurringOptimizationLookbackMonths}",
        "--recent-months",
        "${input:recurringOptimizationRecentMonths}",
        "--optimizable-type",
        "${input:recurringOptimizationOptimizableType}"
      ]
    },
    {
      "name": "Reports - Business",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/reports/business_report.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--group-terms",
        "${input:businessReportGroups}",
        "--exclude-group-terms",
        "${input:businessReportExcludeGroups}",
        "--fiscal-year",
        "${input:businessReportYear}"
      ]
    },
    {
      "name": "Tools - Current File With Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": "${command:pickArgs}"
    }
  ]
}
